# Porta interna que sua API escuta (ex: 5000)
PORT=5000

# Banco: use UM dos dois abaixo

# a) Mongo em container (compose)
MONGO_URI=mongodb://mongo:27017/apicemiterio

# b) Mongo Atlas / externo (recomendado p/ produção)
# MONGO_URI=mongodb+srv://usuario:senha@cluster/url-apicemiterio

# JWT (troque por algo forte)
JWT_SECRET=Alicinha@123

# Caminho de uploads (onde seu código salva as imagens)
UPLOAD_DIR=/app/public/images/sepultados

